@startuml Sequence_Diagram_Dashboard_Alert_Retrieval_Flow
skinparam shadowing false
skinparam sequenceMessageAlign left
autonumber

actor Volunteer
participant "Browser (JS)" as UI
boundary InventoryController
control InventoryManager
control ExpirationAlertService as Alerts
database "InventoryRepository\n(SQLite)" as BatchRepo
entity BatchEntity
entity BatchDTO

Volunteer -> UI : open dashboard
UI -> InventoryController : GET /api/dashboard
InventoryController -> InventoryManager : getDashboard()
InventoryManager -> Alerts : getSummary()

alt cachedSummary exists and cachedDate == today
  Alerts --> InventoryManager : cachedSummary
else cache empty (stock changed) or day changed
  Alerts -> BatchRepo : findByActiveTrueOrderByExpirationDateAsc()
  BatchRepo --> Alerts : List<BatchEntity> (FEFO order)
  loop for each BatchEntity
    Alerts -> BatchEntity : calculateDaysUntilExpiration()
    BatchEntity --> Alerts : days
    Alerts -> Alerts : classify(days)
    Alerts -> BatchDTO ** : <<create>> (name, quantity, days, status)
  end
  Alerts -> Alerts : build DashboardDTO\n(counts + pinned items), store in cache
  Alerts --> InventoryManager : DashboardDTO
end

InventoryManager --> InventoryController : DashboardDTO
InventoryController --> UI : 200 OK (DashboardDTO JSON)
UI --> Volunteer : render counts, colour badges\nand expired-stock banner

note over InventoryController, BatchRepo
If SQLite fails, the DataAccessException reaches the controller,
which returns 503 Service Unavailable. The UI shows an error banner,
never "No expiring items". An empty stock returns a DashboardDTO with zero counts.
end note
@enduml