@startuml Sequence_Diagram_Batch_Registration_Flow
skinparam shadowing false
skinparam sequenceMessageAlign left
autonumber

actor Volunteer
participant "Browser (JS)" as UI
boundary InventoryController
control InventoryManager
entity BatchEntity
database "InventoryRepository\n(SQLite)" as BatchRepo
database "MovementRepository\n(SQLite)" as MoveRepo
control "ExpirationAlertService\n<<AlertObserver>>" as Alerts

Volunteer -> UI : fill in and submit "Add New Batch" form
UI -> InventoryController : POST /api/batches\n(CreateBatchRequest JSON)
InventoryController -> InventoryManager : registerBatch(req, user)
InventoryManager -> InventoryManager : validateBatch(req)

alt Validation failed (quantity <= 0, use-by date in the past, missing field)
  InventoryManager --> InventoryController : throw IllegalArgumentException
  InventoryController --> UI : 400 Bad Request (error message)
  UI --> Volunteer : highlight invalid fields
else Validation passed
  group @Transactional
    InventoryManager -> BatchEntity ** : <<create>> from req
    InventoryManager -> BatchRepo : save(batchEntity)
    BatchRepo --> InventoryManager : savedBatch (with batchId)
    InventoryManager -> MoveRepo : save(ENTRY movement)
    MoveRepo --> InventoryManager : savedMovement
  end
  InventoryManager ->> Alerts : notifyObservers() -> onStockChanged()\n[asynchronous, @Async]
  note right of Alerts : clears cachedSummary;\nnext dashboard request\nrebuilds it
  InventoryManager --> InventoryController : BatchDTO
  InventoryController --> UI : 201 Created (BatchDTO JSON)
  UI --> Volunteer : show success message
end
@enduml